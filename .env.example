# ========================================================
# Classroom Testing System - Environment Configuration
# ========================================================

# Runtime Environment
NODE_ENV=production

# Server Port & Binding (Render automatically injects PORT, e.g. 10000)
PORT=3001
HOST=0.0.0.0

# Database Configuration (Render PostgreSQL or local/fallback)
# - For Render Managed PostgreSQL: Paste the "Internal Database URL" or "External Database URL"
# - Leave empty to use embedded PGlite engine (.pgdata directory) for zero-config demo/local mode
# Example: postgresql://username:password@dpg-xxxx-a.render.com/classroom_test_db
DATABASE_URL=

# Game Rules & Concurrency
TEST_DURATION_SECONDS=1200
MAX_STUDENTS_PER_GAME=50

# Academic Grading Thresholds (percentages 0-100)
GRADE_5_MIN=90
GRADE_4_MIN=75
GRADE_3_MIN=50
GRADE_2_MIN=0

# Security Session Secret (Render Blueprint auto-generates or set your own random string)
SESSION_SECRET=classroom_super_secret_key_change_in_production_2026
